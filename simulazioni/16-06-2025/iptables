iptables -F
iptables -t nat -F

iptables -P INPUT DROP
iptables -P FORWARD DROP

iptables -A INPUT -p icmp -i eth1 -j ACCEPT

iptables -A INPUT -p tcp --dport 22 -i eth1 -j ACCEPT

iptables -A FORWARD -p tcp --dport 80 -i eth0 -j ACCEPT
iptables -A FORWARD -p tcp --dport 443 -i eth0 -j ACCEPT
iptables -A FORWARD -p tcp --dport 80 -i eth1 -j ACCEPT
iptables -A FORWARD -p tcp --dport 443 -i eth1 -j ACCEPT

iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

iptables -t nat -A POSTROUTING -o eth0 -j SNAT --to-source 203.0.113.10

iptables -t nat -A PREROUTING -i eth0 -p tcp --dport 443 -j DNAT --to-destination 192.168.50.20:30443
iptables -A FORWARD -p tcp --dport 30443 -i eth0 -o eth1 -d 192.168.50.20 -j ACCEPT